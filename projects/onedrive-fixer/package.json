{
  "name": "onedrive-fixer",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.js",
  "dependencies": {
    "@inquirer/prompts": "^7.1.0",
    "common": "0.1.0",
    "exiftool-vendored": "^29.0.0",
    "heic-convert": "^2.1.0",
    "trash": "^9.0.0"
  },
  "scripts": {
    "clean": "tsc --build --clean",
    "build": "tsc --build",
    "start": "npm run build && node dist/main.js",
    "test": "vitest",
    "bundle": "npm run clean && rm -rf out/bundle && npm run build && node esbuild.js",
    "pack": "npm run bundle && packseb -m out/bundle/bundle.mjs -o out"
  },
  "devDependencies": {
    "@types/heic-convert": "^2.1.0",
    "@types/heic-decode": "^1.1.2",
    "esbuild": "^0.24.0"
  }
}
